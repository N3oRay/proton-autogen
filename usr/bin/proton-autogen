#!/usr/bin/env python3

import os
import sys
import subprocess
import re
from shutil import which
from proton_autogen.backend import find_windows_programs, list_programs






DEBUG = "--debug" in sys.argv

ENABLE_MANGOHUD = "--mangohud" in sys.argv

VERSION = "2.2.5"


PROTON_PATHS = [
    "~/.steam/root/compatibilitytools.d",
    "~/.steam/debian-installation/compatibilitytools.d",
    "~/.local/share/Steam/compatibilitytools.d",
    # Proton officiels Steam
    "~/.steam/steam/steamapps/common",
    # Flatpak
    "~/.var/app/com.valvesoftware.Steam/.local/share/Steam/compatibilitytools.d",
    "~/.var/app/com.valvesoftware.Steam/.steam/root/compatibilitytools.d",
]


def print_help():
    print("""proton-autogen

Usage:
  proton-autogen <file.exe>
  proton-autogen run <file.exe>

Information:
  proton-autogen --version
  proton-autogen --about
  proton-autogen --help

Discovery:
  proton-autogen --list-protons
  proton-autogen --list-programs
  proton-autogen --diagnostic

Options:
  --debug        Verbose output
  --mangohud     Enable MangoHud overlay

Examples:
  proton-autogen game.exe
  proton-autogen game.exe --mangohud
  proton-autogen run game.exe
  proton-autogen --list-protons
  proton-autogen --list-programs
  proton-autogen --diagnostic

Notes:
  - Automatically selects the newest available Proton version
  - Falls back to Wine if Proton runtime is unavailable
  - Supports Steam, Flatpak, and compatibilitytools installs
""")



def print_diagnostic():
    print("proton-autogen diagnostic")
    print("")
    print(f"Version      : {VERSION}")
    print(f"Python       : {sys.version.split()[0]}")
    print("")

    print("Runtime:")
    print(f"  proton-call : {'yes' if has_proton_call() else 'no'}")
    print(f"  wine        : {'yes' if has_wine() else 'no'}")
    print(f"  gamemode    : {'yes' if has_gamemode() else 'no'}")
    print(f"  mangohud    : {'yes' if has_mangohud() else 'no'}")
    print("")

    print(f"Platform     : {sys.platform}")
    print("")

    protons = find_all_protons()

    print(f"Detected Proton installations: {len(protons)}")
    print("")

    if protons:
        selected = find_proton()

        for proton in sorted(protons):
            marker = " [selected]" if proton == selected else ""

            print(
                f"  {os.path.basename(proton)}{marker}"
            )
            print(f"    {proton}")
    else:
        print("  none")

    print("")

def find_all_protons():
    protons = []

    for base in PROTON_PATHS:
        base = os.path.expanduser(base)

        if not os.path.exists(base):
            continue

        for d in os.listdir(base):
            full = os.path.join(base, d)

            if os.path.isdir(full) and "Proton" in d:
                protons.append(full)

    return protons


def list_protons():
    protons = find_all_protons()

    if not protons:
        print("No Proton installation found")
        return

    selected = find_proton()

    print("Detected Proton installations:")
    print("")

    for proton in sorted(protons):
        suffix = " (selected)" if proton == selected else ""
        print(f"  {os.path.basename(proton)}{suffix}")
        print(f"    {proton}")
        print("")


def print_about():
    print("proton-autogen")
    print("")
    print("Description:")
    print("  Automatic Proton/Wine launcher for Windows executables")
    print("")
    print(f"Version: {VERSION}")
    print("")
    print("Features:")
    print("  - Automatic Proton detection")
    print("  - Automatic selection of newest Proton version")
    print("  - Wine fallback")
    print("  - GameMode support (optional)")
    print("  - Integration with file managers")
    print("")
    print("Author: N3oray")
    print("License: MIT (or your license)")
    print("Repository: https://github.com/N3oRay/proton-autogen")

def print_runtime_info(proton, exe_path, mangohud_available):
    proton_name = os.path.basename(proton)

    print("[proton-autogen] Runtime information")
    print(f"  Executable : {exe_path}")
    print(f"  Proton     : {proton_name}")
    print(f"  Path       : {proton}")

    if has_proton_call():
        print("  proton-call: detected")
    else:
        print("  proton-call: missing")

    if has_gamemode():
        print("  GameMode   : enabled")
    else:
        print("  GameMode   : disabled")

    if mangohud_available:
        print("  MangoHud   : available")
    else:
        print("  MangoHud   : unavailable")

    print("")


def has_proton_call():
    return which("proton-call") is not None


def has_wine():
    return which("wine") is not None

def has_mangohud():
    return which("mangohud") is not None

def run_standard(exe_path: str):
    print("[proton-autogen] Proton unavailable → using Wine fallback")

    if has_wine():
        result = subprocess.run(["wine", exe_path])
        sys.exit(result.returncode)
    else:
        print("[proton-autogen] ERROR: No runtime found")
        print("")
        print("Missing:")
        print("  - Proton")
        print("  - Wine")
        print("")
        print("Install Wine:")
        print("  sudo apt install wine")
        sys.exit(1)



def has_gamemode():
    return which("gamemoderun") is not None


def proton_score(name):
    numbers = [int(n) for n in re.findall(r'\d+', name)]

    major = numbers[0] if len(numbers) > 0 else 0
    minor = numbers[1] if len(numbers) > 1 else 0

    return (
        major,
        minor,
        name.lower()
    )

def find_proton():
    candidates = []

    for base in PROTON_PATHS:
        base = os.path.expanduser(base)

        if not os.path.exists(base):
            continue

        for d in os.listdir(base):
            full = os.path.join(base, d)

            if os.path.isdir(full) and "Proton" in d:
                candidates.append(full)

    if not candidates:
        return None

    candidates.sort(
        key=lambda x: proton_score(os.path.basename(x)),
        reverse=True
    )

    return candidates[0]



def run(exe_path: str):
    exe_path = os.path.abspath(exe_path)

    if not os.path.exists(exe_path):
        print(f"Error: file not found: {exe_path}")
        sys.exit(1)

    # Proton path (à adapter)
    #proton = os.path.expanduser(
    #    "~/.steam/debian-installation/compatibilitytools.d/GE-Proton10-34/"
    #)

    proton = find_proton()

    mangohud_available = has_mangohud()



    if proton:
        print_runtime_info(proton, exe_path, mangohud_available)
    else:
        print("[proton-autogen] ERROR: No Proton installation found")
        print("")
        print("Install GE-Proton with:")
        print("  protonup-qt")
        print("")
        print("Or install Proton-GE from command line:")
        print("  protonup -d ~/.steam/root/compatibilitytools.d")
        print("")
        print("Then restart Steam and try again.")
        sys.exit(1)

    if has_proton_call():
        env = os.environ.copy()
        env["GE_PROTON"] = proton
        env["GAME_EXE"] = exe_path
        # env gaming options OK
        env["DXVK_HUD"] = "compiler"
        env["RADV_PERFTEST"] = "gpl"
        env["WINEESYNC"] = "1"
        env["WINEFSYNC"] = "1"
        env["WINE_SIMULATE_WRITECOPY"] = "1"
        env["WINEDLLOVERRIDES"] = "winegstreamer=d"

        if ENABLE_MANGOHUD:
            if mangohud_available:
                env["MANGOHUD"] = "1"
                env["DXVK_HUD"] = "0"
                env.pop("LD_PRELOAD", None)
            else:
                print("[proton-autogen] WARNING: MangoHud requested but not installed")

        cmd = []

        if has_gamemode():
            cmd.append("gamemoderun")
        elif DEBUG:
            print("[proton-autogen] GameMode not found")

        cmd += [
            "proton-call",
            "-c", proton,
            "-r", exe_path
        ]

        if ENABLE_MANGOHUD and mangohud_available:
            print("[proton-autogen] MangoHud enabled")

        print(
            f"[proton-autogen] Launching with "
            f"{os.path.basename(proton)}"
        )

        #subprocess.run(cmd, env=env)
        result = subprocess.run(cmd, env=env)
        sys.exit(result.returncode)

    else:
        run_standard(exe_path)

def main():
    if "--about" in sys.argv:
        print_about()
        return

    if "--version" in sys.argv:
        print(f"proton-autogen {VERSION}")
        return

    if "--list-protons" in sys.argv:
        list_protons()
        return

    if "--diagnostic" in sys.argv:
        print_diagnostic()
        return

    if "--list-programs" in sys.argv:
        list_programs()
        return

    if "--help" in sys.argv or "-h" in sys.argv:
        print_help()
        return

    if len(sys.argv) < 2:
        print("Usage: proton-autogen <file.exe>")
        return

    if sys.argv[1] == "run":
        if len(sys.argv) < 3:
            print("Error: missing file.exe")
            return
        run(sys.argv[2])
    else:
        run(sys.argv[1])


if __name__ == "__main__":
    main()
