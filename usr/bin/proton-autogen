#!/usr/bin/env python3

import os
import sys
import subprocess
import re
from shutil import which
from proton_autogen.backend import find_windows_programs, list_programs, add_game, load_game_config, find_proton_by_name, find_proton, has_gamemode, has_mangohud, normalize_flag, find_all_protons, print_diagnostic, list_protons, has_proton_call, has_wine, proton_name, proton_path, PROTON_PATHS, VERSION


DEBUG = "--debug" in sys.argv

def normalize_proton(p):
    if isinstance(p, dict):
        return p.get("path")
    return p

def print_help():
    print("""proton-autogen

Usage:
  proton-autogen <file.exe>
  proton-autogen run <file.exe>
  proton-autogen add <file.exe>

Information:
  proton-autogen --version
  proton-autogen --about
  proton-autogen --help

Discovery:
  proton-autogen --list-protons
  proton-autogen --list-programs
  proton-autogen --diagnostic

Game management:
  proton-autogen add <file.exe>
      Create a game profile in ~/.config/proton-autogen/

Execution:
  proton-autogen <file.exe>
      Run game using automatic Proton selection or saved config

  proton-autogen run <file.exe>
      Force execution without profile override

Options:
  --debug        Verbose output
  --mangohud     Enable MangoHud overlay
  --gamemode     Enable GameMode

Examples:
  proton-autogen add game.exe
  proton-autogen game.exe
  proton-autogen run game.exe
  proton-autogen game.exe --mangohud

Notes:
  - Uses saved JSON config when available
  - Automatically selects best Proton version
  - Falls back to Wine if Proton is unavailable
  - Supports Steam, Flatpak, and compatibilitytools installs
""")




def print_about():
    print("proton-autogen")
    print("")
    print("Description:")
    print("  Automatic Proton/Wine launcher for Windows executables")
    print("")
    print(f"Version: {VERSION}")
    print("")
    print("Features:")
    print("  - Automatic Proton detection")
    print("  - Automatic selection of newest Proton version")
    print("  - Wine fallback")
    print("  - GameMode support (optional)")
    print("  - Integration with file managers")
    print("")
    print("Author: N3oray")
    print("License: MIT (or your license)")
    print("Repository: https://github.com/N3oRay/proton-autogen")

def print_runtime_info(proton, exe_path, mangohud_available):
    print("[proton-autogen] Runtime information")
    print(f"  Executable : {exe_path}")
    print(f"  Proton     : {proton_name(proton)}")
    print(f"  Path       : {proton_path(proton)}")

    print("  proton-call:", "detected" if has_proton_call() else "missing")
    print("  GameMode  :", "enabled" if has_gamemode() else "disabled")
    print("  MangoHud  :", "available" if mangohud_available else "unavailable")
    print("")



def run_standard(exe_path: str):
    print("[proton-autogen] Proton unavailable → using Wine fallback")

    if has_wine():
        result = subprocess.run(["wine", exe_path])
        sys.exit(result.returncode)
    else:
        print("[proton-autogen] ERROR: No runtime found")
        print("")
        print("Missing:")
        print("  - Proton")
        print("  - Wine")
        print("")
        print("Install Wine:")
        print("  sudo apt install wine")
        sys.exit(1)

def proton_path(p):
    if isinstance(p, dict):
        return p.get("path")
    return p

def run(exe_path: str):
    exe_path = os.path.abspath(exe_path)

    if not os.path.exists(exe_path):
        print(f"Error: file not found: {exe_path}")
        sys.exit(1)

    # Proton path (à adapter)
    #proton = os.path.expanduser(
    #    "~/.steam/debian-installation/compatibilitytools.d/GE-Proton10-34/"
    #)
    mangohud_available = has_mangohud()

    config = load_game_config(exe_path)

    if config:
        proton_name = config.get("proton")
        cfg_mangohud = normalize_flag(config.get("mangohud"), True)
        cfg_gamemode = normalize_flag(config.get("gamemode"), True)
        proton = find_proton_by_name(proton_name)

        if not proton:
            print("[proton-autogen] stored Proton missing → fallback")
            proton = find_proton()
    else:
        cfg_mangohud = True
        cfg_gamemode = True
        proton = find_proton()


    enable_mangohud = cfg_mangohud
    enable_gamemode = cfg_gamemode

    # CLI overrides (priorité utilisateur)
    if "--mangohud" in sys.argv:
        enable_mangohud = True

    if "--gamemode" in sys.argv:
        enable_gamemode = True


    if proton:
        print_runtime_info(proton, exe_path, mangohud_available)
    else:
        print("[proton-autogen] ERROR: No Proton installation found")
        print("")
        print("Install GE-Proton with:")
        print("  protonup-qt")
        print("")
        print("Or install Proton-GE from command line:")
        print("  protonup -d ~/.steam/root/compatibilitytools.d")
        print("")
        print("Then restart Steam and try again.")
        sys.exit(1)

    if has_proton_call():
        env = os.environ.copy()
        env["GE_PROTON"] = proton_path(proton)
        env["GAME_EXE"] = exe_path
        # env gaming options OK
        env["DXVK_HUD"] = "compiler"
        env["RADV_PERFTEST"] = "gpl"
        env["WINEESYNC"] = "1"
        env["WINEFSYNC"] = "1"
        env["WINE_SIMULATE_WRITECOPY"] = "1"
        env["WINEDLLOVERRIDES"] = "winegstreamer=d"

        if enable_mangohud:
            if mangohud_available:
                print("[proton-autogen] MangoHud enabled")
                env["MANGOHUD"] = "1"
                env["DXVK_HUD"] = "0"
                env.pop("LD_PRELOAD", None)
            else:
                print("[proton-autogen] WARNING: MangoHud requested but not installed")

        cmd = []

        if enable_gamemode:
            if has_gamemode():
                print("[proton-autogen] GameMode enabled")
                cmd.append("gamemoderun")
        elif DEBUG:
            print("[proton-autogen] GameMode not found")

        cmd += [
            "proton-call",
            "-c", proton_path(proton),
            "-r", exe_path
        ]

        print(f"[proton-autogen] Launching with {proton_name(proton) if callable(proton_name) else proton_name}")

        #subprocess.run(cmd, env=env)
        result = subprocess.run(cmd, env=env)
        sys.exit(result.returncode)

    else:
        run_standard(exe_path)

def main():

    if "--about" in sys.argv:
        print_about()
        return

    if "--version" in sys.argv:
        print(f"proton-autogen {VERSION}")
        return

    if "--list-protons" in sys.argv:
        list_protons()
        return

    if "--diagnostic" in sys.argv:
        print_diagnostic()
        return

    if "--list-programs" in sys.argv:
        list_programs()
        return

    if "--help" in sys.argv or "-h" in sys.argv:
        print_help()
        return


    if len(sys.argv) < 2:
        print("Usage: proton-autogen <file.exe>")
        return

    if sys.argv[1] == "add":
        if len(sys.argv) < 3:
            print("Usage: proton-autogen add <file.exe>")
            return
        add_game(sys.argv[2])
        return

    if sys.argv[1] == "run":
        if len(sys.argv) < 3:
            print("Error: missing file.exe")
            return
        run(sys.argv[2])
    else:
        run(sys.argv[1])


if __name__ == "__main__":
    main()
