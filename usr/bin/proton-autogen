def print_runtime_info(proton, exe_path, mangohud_available):
    print("[proton-autogen] Runtime information")
    print(f"  Executable : {exe_path}")
    print(f"  Proton     : {proton_name(proton)}")
    print(f"  Path       : {proton_path(proton)}")

    print("  proton-call:", "detected" if has_proton_call() else "missing")
    print("  GameMode  :", "available" if has_gamemode() else "unavailable")
    print("  MangoHud  :", "available" if mangohud_available else "unavailable")
    print("")




def run_standard(exe_path: str):
    print("[proton-autogen] Proton unavailable → using Wine fallback")

    if not has_wine():
        print("[proton-autogen] ERROR: No runtime found")
        print()
        print("Missing:")
        print("  - Proton")
        print("  - Wine")
        print()
        print("Install Wine:")
        print("  sudo apt install wine")
        sys.exit(1)

    if not Path(exe_path).is_file():
        print(f"✗ File not found: {exe_path}")
        sys.exit(1)

    try:
        exe_path = Path(exe_path).resolve()

        result = subprocess.run(
            ["wine", str(exe_path)],
            cwd=str(exe_path.parent)
        )

        sys.exit(result.returncode)

    except Exception as e:
        print(f"✗ Error running {exe_path} with Wine: {e}")
        sys.exit(1)


def base_env(enable_mangohud=False, enable_gamemode=False, oldgame=False):
    env = os.environ.copy()

    # HARD CLEAN (important)
    for k in [
        "LD_PRELOAD",
        "LD_LIBRARY_PATH",
        "VK_ICD_FILENAMES",
        "VK_DRIVER_FILES"
    ]:
        env.pop(k, None)

    env["PROTONFIXES_DISABLE"] = "1"
    env["PROTON_LOG"] = "1"
    env["WINEDEBUG"] = "err+all"

    if oldgame:
       print(f"[proton-autogen] Launch mode: OLD GAME support - UT99 / DX8 / D3D8 !")
       env["PROTON_USE_WINED3D"] = "1"
       env["WINEDLLOVERRIDES"] = "d3d8=n,b"
       env["PROTON_NO_ESYNC"] = "1"
       env["PROTON_NO_FSYNC"] = "1"


    if enable_mangohud == False:
        env["DXVK_HUD"] = "compiler"
        env["RADV_PERFTEST"] = "gpl"
        env["WINEESYNC"] = "1"
        env["WINEFSYNC"] = "1"

    env["vblank_mode"] = "0"
    env["mesa_glthread"] = "true"

    env["WINE_SIMULATE_WRITECOPY"] = "1"
    env["WINEDLLOVERRIDES"] = "winegstreamer=d"


    env["STEAM_COMPAT_APP_ID"] = "0"
    env["PROTON_DISABLE_XALIA"] = "1"

    return env


def get_prefix_path(prefix_mode: str, exe_path: str) -> str:
    root = os.path.expanduser("~/Documents/Proton/env")

    if prefix_mode == "auto":
        name = os.path.splitext(
            os.path.basename(exe_path)
        )[0]

        # Nettoyage minimal du nom
        safe_name = (
            name.replace(" ", "_")
                .replace("/", "_")
                .replace("\\", "_")
        )

        short_hash = hashlib.md5(
            exe_path.encode()
        ).hexdigest()[:8]

        return os.path.join(
            root,
            f"{safe_name}-{short_hash}"
        )

    prefixes = {
        "main": os.path.join(root, "main"),
        "shared": os.path.join(root, "shared"),
        "custom": os.path.expanduser(
            "~/Documents/Proton/env/Proton Custom"
        ),
    }

    return prefixes.get(
        prefix_mode,
        prefixes["main"]
    )

def run_game_proton(exe_path, proton, launch_mode="proton",
                    enable_mangohud=False, enable_gamemode=False,
                    prefix_mode="main", oldgame=False):

    game_id = hashlib.md5(exe_path.encode()).hexdigest()



    # =========================
    # PROTON MODE
    # =========================
    if launch_mode == "proton":

        env = base_env(
            enable_mangohud=enable_mangohud,
            enable_gamemode=enable_gamemode,
            oldgame=oldgame
        )

        prefix_path = get_prefix_path(prefix_mode, exe_path)
        print(f"[proton-autogen] Prefix mode : {prefix_mode}")
        print(f"[proton-autogen] Prefix path : {prefix_path}")

        env["STEAM_COMPAT_DATA_PATH"] = prefix_path
        os.makedirs(prefix_path, exist_ok=True)

        env["STEAM_COMPAT_CLIENT_INSTALL_PATH"] = os.path.expanduser("~/.steam/steam")
        env["STEAM_COMPAT_TOOL_PATHS"] = proton_path(proton)

        cmd = [
            os.path.join(proton_path(proton), "proton"),
            "run",
            exe_path
        ]

    # =========================
    # PROTON-CALL MODE
    # =========================
    elif launch_mode == "proton-call":

        env = base_env(
            enable_mangohud=enable_mangohud,
            enable_gamemode=enable_gamemode,
            oldgame=oldgame
        )

        # keep prefix if defined externally
        if "STEAM_COMPAT_DATA_PATH" not in os.environ:
            env.pop("STEAM_COMPAT_DATA_PATH", None)

        for k in [
            "STEAM_COMPAT_CLIENT_INSTALL_PATH",
            "STEAM_COMPAT_TOOL_PATHS",
            "STEAM_COMPAT_APP_ID"
        ]:
            env.pop(k, None)

        cmd = [
            "proton-call",
            "-c", proton_path(proton),
            "-r", exe_path
        ]

    else:
        raise ValueError(f"Unknown launch mode: {launch_mode}")

    # =========================
    # COMMON OPTIONS
    # =========================

    if enable_mangohud and has_mangohud():
        env["MANGOHUD"] = "1"
        env["DXVK_HUD"] = "0"
    else:
        env.pop("MANGOHUD", None)

    if enable_gamemode and has_gamemode():
        env["GAMEMODE"] = "1"

    print(f"[proton-autogen] Launch mode: {launch_mode}")

    result = subprocess.run(cmd, env=env)
    sys.exit(result.returncode)


def run(exe_path: str, launch_mode="proton", prefix_mode="main", oldgame=False):
    exe_path = os.path.abspath(exe_path)

    if not os.path.exists(exe_path):
        print(f"Error: file not found: {exe_path}")
        sys.exit(1)

    # Proton path (à adapter)
    #proton = os.path.expanduser(
    #    "~/.steam/debian-installation/compatibilitytools.d/GE-Proton10-34/"
    #)
    mangohud_available = has_mangohud()

    config = load_game_config(exe_path)

    if config:
        saved_proton_name = config.get("proton")
        cfg_mangohud = normalize_flag(config.get("mangohud"), True)
        cfg_gamemode = normalize_flag(config.get("gamemode"), True)
        proton = find_proton_by_name(saved_proton_name)

        if not proton:
            print("[proton-autogen] stored Proton missing → fallback")
            proton = find_proton()
    else:
        # By Default
        cfg_mangohud = False
        cfg_gamemode = False
        proton = find_proton()


    enable_mangohud = cfg_mangohud
    enable_gamemode = cfg_gamemode

    # CLI overrides (priorité utilisateur)
    if "--mangohud" in sys.argv:
        enable_mangohud = True

    if "--gamemode" in sys.argv:
        enable_gamemode = True


    if proton:
        print_runtime_info(proton, exe_path, mangohud_available)
    else:
        print("[proton-autogen] ERROR: No Proton installation found")
        print("")
        print("Install GE-Proton with:")
        print("  protonup-qt")
        print("")
        print("Or install Proton-GE from command line:")
        print("  protonup -d ~/.steam/root/compatibilitytools.d")
        print("")
        print("Then restart Steam and try again.")
        sys.exit(1)

    if launch_mode == "proton-call" and has_proton_call():
        env = base_env(
            enable_mangohud=enable_mangohud,
            enable_gamemode=enable_gamemode,
            oldgame=oldgame
        )
        env["GE_PROTON"] = proton_path(proton)
        env["GAME_EXE"] = exe_path

        if enable_mangohud:
            if mangohud_available:
                print("[proton-autogen] MangoHud enabled")
                env["MANGOHUD"] = "1"
                env["DXVK_HUD"] = "0"
                env.pop("LD_PRELOAD", None)
            else:
                print("[proton-autogen] WARNING: MangoHud requested but not installed")

        cmd = []

        if enable_gamemode:
            if has_gamemode():
                print("[proton-autogen] GameMode enabled")
                #cmd.append("gamemoderun")
                env["GAMEMODE"] = "1"
        elif DEBUG:
            print("[proton-autogen] GameMode not found")

        cmd += [
            "proton-call",
            "-c", proton_path(proton),
            "-r", exe_path
        ]

        print(f"[proton-autogen] Launching with {proton_name(proton)}")

        #subprocess.run(cmd, env=env)
        result = subprocess.run(cmd, env=env)
        sys.exit(result.returncode)

    elif launch_mode == "proton" and proton:
        run_game_proton(exe_path, proton, "proton", enable_mangohud, enable_gamemode, prefix_mode, oldgame)

    elif launch_mode == "wine":
        run_standard(exe_path)


def main():

    if "--about" in sys.argv:
        print_about()
        return

    if "--version" in sys.argv:
        print(f"proton-autogen {VERSION}")
        return

    if "--list-protons" in sys.argv:
        list_protons()
        return

    if "--proton-paths" in sys.argv:
        print_proton_paths()
        return

    if "--diag" in sys.argv:
        print_diagnostic()
        return

    if "--list-programs" in sys.argv:
        list_programs()
        return

    if "--help" in sys.argv or "-h" in sys.argv:
        print_help()
        return
    # Mode execution
    launch_mode = "proton"

    if "--call" in sys.argv:
        launch_mode = "proton-call"
    elif "--wine" in sys.argv:
        launch_mode = "wine"
    elif "--proton" in sys.argv:
        launch_mode = "proton"

    # Mode prefix
    prefix_mode = "main"

    if "--ps" in sys.argv:
        prefix_mode = "shared"
    elif "--pa" in sys.argv:
        prefix_mode = "auto"
    elif "--pc" in sys.argv:
        prefix_mode = "custom"

    # Mode old game support (sample: UT99)
    oldgame = False
    if "--o" in sys.argv:
        oldgame = True


    if len(sys.argv) < 2:
        print("Usage: proton-autogen <file.exe>")
        return

    if sys.argv[1] == "add":
        if len(sys.argv) < 3:
            print("Usage: proton-autogen add <file.exe>")
            return
        add_game(sys.argv[2])
        return

    if sys.argv[1] == "run":
        if len(sys.argv) < 3:
            print("Error: missing file.exe")
            return
        run(sys.argv[2],launch_mode, prefix_mode, oldgame)
    else:
        run(sys.argv[1],launch_mode, prefix_mode, oldgame)


if __name__ == "__main__":
    main()
