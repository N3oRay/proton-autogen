#!/usr/bin/env python3

import sys
import os
import subprocess

from shutil import which

DEBUG = "--debug" in sys.argv

VERSION = "2.0.4"


PROTON_PATHS = [
    "~/.steam/root/compatibilitytools.d",
    "~/.steam/debian-installation/compatibilitytools.d",
    "~/.local/share/Steam/compatibilitytools.d",
]


def print_runtime_info(proton, exe_path):
    proton_name = os.path.basename(proton)

    print("[proton-autogen] Runtime information")
    print(f"  Executable : {exe_path}")
    print(f"  Proton     : {proton_name}")
    print(f"  Path       : {proton}")

    if has_proton_call():
        print("  proton-call: detected")
    else:
        print("  proton-call: missing")

    if has_gamemode():
        print("  GameMode   : enabled")
    else:
        print("  GameMode   : disabled")

    print("")

def has_proton_call():
    return which("proton-call") is not None


def has_wine():
    return which("wine") is not None

def run_standard(exe_path: str):
    print("[proton-autogen] Proton unavailable → using Wine fallback")

    if has_wine():
        subprocess.run(["wine", exe_path])
    else:
        print("[proton-autogen] ERROR: No runtime found")
        print("")
        print("Missing:")
        print("  - Proton")
        print("  - Wine")
        print("")
        print("Install Wine:")
        print("  sudo apt install wine")
        sys.exit(1)



def has_gamemode():
    return which("gamemoderun") is not None

def proton_score(name):
    score = 0
    if "GE-Proton" in name:
        score += 100
    if "Proton" in name:
        score += 50
    return score

def find_proton():
    for base in PROTON_PATHS:
        base = os.path.expanduser(base)

        if not os.path.exists(base):
            continue

        candidates = []
        for d in os.listdir(base):
            full = os.path.join(base, d)

            if os.path.isdir(full) and ("Proton" in d or "GE-Proton" in d):
                candidates.append(full)

        if candidates:
            candidates.sort(
                key=lambda x: proton_score(os.path.basename(x)),
                reverse=True
            )
            return candidates[0]

    return None



def run(exe_path: str):
    exe_path = os.path.abspath(exe_path)

    if not os.path.exists(exe_path):
        print(f"Error: file not found: {exe_path}")
        sys.exit(1)

    # ⚠️ simple detection (MVP)
    #name = os.path.basename(exe_path).lower()

    # Proton path (à adapter)
    #proton = os.path.expanduser(
    #    "~/.steam/debian-installation/compatibilitytools.d/GE-Proton10-34/"
    #)

    proton = find_proton()



    if proton:
        print_runtime_info(proton, exe_path)
    else:
        print("[proton-autogen] ERROR: No Proton installation found")
        print("")
        print("Install GE-Proton with:")
        print("  protonup-qt")
        print("")
        print("Or install Proton-GE from command line:")
        print("  protonup -d ~/.steam/root/compatibilitytools.d")
        print("")
        print("Then restart Steam and try again.")
        sys.exit(1)

    if has_proton_call():
        env = os.environ.copy()
        env["GE_PROTON"] = proton
        env["GAME_EXE"] = exe_path

        cmd = []

        if has_gamemode():
            cmd.append("gamemoderun")
        elif DEBUG:
            print("[proton-autogen] GameMode not found")

        cmd += [
            "proton-call",
            "-c", proton,
            "-r", exe_path
        ]

        print(
            f"[proton-autogen] Launching with "
            f"{os.path.basename(proton)}"
        )

        subprocess.run(cmd, env=env)

    else:
        run_standard(exe_path)

if __name__ == "__main__":

    if "--version" in sys.argv:
        print(f"proton-autogen {VERSION}")
        sys.exit(0)

    if "--help" in sys.argv or "-h" in sys.argv:
        print("""proton-autogen

Usage:
  proton-autogen <file.exe>
  proton-autogen run <file.exe>

Options:
  --version   Show version
  --help      Show this help
  --debug     Verbose output
""")
        sys.exit(0)

    if len(sys.argv) < 2:
        print("Usage: proton-autogen <file.exe>")
        sys.exit(1)

    if sys.argv[1] == "run":
        if len(sys.argv) < 3:
            print("Error: missing file.exe")
            sys.exit(1)
        run(sys.argv[2])
    else:
        run(sys.argv[1])
