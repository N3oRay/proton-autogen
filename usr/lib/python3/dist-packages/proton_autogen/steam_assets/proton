#!/usr/bin/env python3
"""Steam entry point for Proton-Autogen.

Steam calls: proton <verb> <executable> [arguments...]
All the logic lives in autogen_wrapper.py (same directory).
"""
import os
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, HERE)

from autogen_wrapper import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
